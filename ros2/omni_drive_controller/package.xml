<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omni_drive_controller</name>
  <version>0.1.0</version>
  <description>Base omni de 3 rodas: cinemática /cmd_vel -> PWM e ponte serial com o Arduino (arduino_robot_control.ino)</description>
  <maintainer email="ras@todo.todo">ras</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>omni_drive_controller_msgs</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_loopback_sim</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
